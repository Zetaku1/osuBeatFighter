<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup Label="Project">
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyTitle>osu.Game.Rulesets.BeatFighter</AssemblyTitle>
    <OutputType>Library</OutputType>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <RootNamespace>osu.Game.Rulesets.BeatFighter</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="Resources\**" />
  </ItemGroup>
<!--  <ItemGroup>
    <PackageReference Include="ppy.osu.Game" Version="2026.429.0" />
  </ItemGroup>-->
<ItemGroup>
    <ProjectReference Include="..\..\osu\osu.Game\osu.Game.csproj" />
</ItemGroup>
<Target Name="CopyRuleset" AfterTargets="Build">
    <Copy SourceFiles="$(OutputPath)$(AssemblyName).dll"
          DestinationFolder="$(AppData)\osu-development\rulesets" />
    <Copy SourceFiles="$(OutputPath)$(AssemblyName).pdb"
          DestinationFolder="$(AppData)\osu-development\rulesets" />
</Target>
</Project>
